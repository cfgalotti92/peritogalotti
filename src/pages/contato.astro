---
import Layout from '../layouts/Layout.astro';

const title = 'Contato | Renato Galotti — Perito Grafotécnico em Todo o Brasil';
const description = 'Entre em contato com o Perito Grafotécnico Renato Galotti. Atendimento para advogados, empresas e particulares. Solicite seu laudo ou parecer técnico.';
---

<Layout
  title={title}
  description={description}
  isTransparentHeader={false}
>
  <main id="main-content">


    <section class="page-hero" aria-label="Contato e Orçamentos">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb" vocab="https://schema.org/" typeof="BreadcrumbList">
            <li property="itemListElement" typeof="ListItem">
              <a href="/" property="item" typeof="WebPage"><span property="name">Início</span></a>
              <meta property="position" content="1">
            </li>
            <li class="breadcrumb__sep" aria-hidden="true">›</li>
            <li property="itemListElement" typeof="ListItem">
              <span class="breadcrumb__current" property="name">Contato</span>
              <meta property="position" content="2">
            </li>
          </ol>
        </nav>
        <div style="text-align:center; max-width:700px; margin: 0 auto; padding-top: 24px;">
          <p class="page-hero__eyebrow">Atendimento Nacional</p>
          <h1 class="page-hero__title">Solicite uma Avaliação</h1>
          <p class="page-hero__desc">Preencha o formulário abaixo ou fale diretamente conosco pelo WhatsApp. O sigilo e a discrição das suas informações são absolutos.</p>
        </div>
      </div>
    </section>

    <section class="section" aria-label="Informações de contato e formulário">
      <div class="container">
        <div class="contact-grid">
          
          <div data-animate>
            <h2 style="font-size:1.75rem; color:var(--navy); margin-bottom:20px;">Fale com o Perito</h2>
            <p style="color:var(--text-muted); margin-bottom:40px;">Para adiantar o seu atendimento, tenha em mãos informações básicas sobre os documentos que precisam ser analisados (quantidade e tipo) e o prazo necessário.</p>
            
            <div class="contact-info__item">
              <div class="contact-info__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              </div>
              <div>
                <div class="contact-info__label">WhatsApp Direto</div>
                <div class="contact-info__value"><a href="https://wa.me/5511976155381" target="_blank" rel="noopener noreferrer" style="color:var(--navy); font-weight:700;">+55 (11) 97615-5381</a></div>
              </div>
            </div>

            <div class="contact-info__item">
              <div class="contact-info__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <div class="contact-info__label">E-mail Profissional</div>
                <div class="contact-info__value"><a href="mailto:contato@peritogalotti.com.br" style="color:var(--navy); font-weight:700;">contato@peritogalotti.com.br</a></div>
              </div>
            </div>

            <div class="contact-info__item">
              <div class="contact-info__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <div class="contact-info__label">Escritório & Envio de Originais</div>
                <div class="contact-info__value" style="color:var(--navy); font-weight:700;">São Paulo — SP | Atendimento Nacional</div>
              </div>
            </div>

            <div style="margin-top:40px; padding:24px; background:var(--gray-100); border-radius:var(--radius-md);">
              <h3 style="font-size:1rem; color:var(--navy); margin-bottom:12px;">Para advogados de outros estados:</h3>
              <p style="font-size:.875rem; color:var(--text-muted); line-height:1.6;">Os documentos questionados e padrões de confronto podem ser enviados inicialmente por meios digitais (digitalizados em alta resolução e formato sem perdas). O perito indicará se haverá necessidade de envio dos originais físicos via SEDEX ou transportadora segura, ou se os exames poderão ser feitos no local onde se encontram.</p>
            </div>
          </div>

          <div class="contact-form" data-animate data-animate-delay="1">
            <h3 style="font-size:1.5rem; color:var(--navy); margin-bottom:12px;">Envie uma Mensagem</h3>
            <p style="color:var(--text-muted); font-size:.9rem; margin-bottom:24px;">Preencha os campos abaixo para receber uma análise técnica preliminar. Sua mensagem será enviada diretamente à nossa caixa postal técnica.</p>
            
            <form id="contact-form" novalidate>
              <div class="form-row">
                <div class="form-group">
                  <label for="name" class="form-label">Nome Completo <span style="color:#e53e3e">*</span></label>
                  <input type="text" id="name" name="name" class="form-control" placeholder="Seu nome ou escritório" required>
                </div>
                <div class="form-group">
                  <label for="phone" class="form-label">Telefone / WhatsApp <span style="color:#e53e3e">*</span></label>
                  <input type="tel" id="phone" name="phone" class="form-control" placeholder="(11) 99999-9999" required>
                </div>
              </div>

              <div class="form-group">
                <label for="email" class="form-label">E-mail para Resposta <span style="color:#e53e3e">*</span></label>
                <input type="email" id="email" name="email" class="form-control" placeholder="seuemail@exemplo.com.br" required>
              </div>
              
              <div class="form-group">
                <label for="subject" class="form-label">Assunto / Tipo de Perícia</label>
                <select id="subject" name="subject" class="form-control">
                  <option value="Perícia Judicial / Assistência Técnica">Perícia Judicial / Assistência Técnica</option>
                  <option value="Perícia Extrajudicial">Perícia Extrajudicial (Contratos, Cheques, etc.)</option>
                  <option value="Reconhecimento de Manuscrito">Reconhecimento de Manuscrito / Falsificação</option>
                  <option value="Consultoria para Escritório">Consultoria para Escritório de Advocacia</option>
                  <option value="Outros">Outros</option>
                </select>
              </div>

              <div class="form-group">
                <label for="message" class="form-label">Detalhes do Caso</label>
                <textarea id="message" name="message" class="form-control" placeholder="Descreva brevemente o documento, prazo processual e urgência..."></textarea>
              </div>

              <button type="submit" class="btn btn--primary btn--full btn--lg">Enviar Mensagem por E-mail</button>

              <div style="text-align:center; margin-top:16px;">
                <span style="font-size:.85rem; color:var(--text-muted);">Prefere resposta imediata?</span>
                <a href="https://wa.me/5511976155381?text=Olá%2C+Dr.+Renato+Galotti!+Preciso+de+uma+perícia+grafotécnica." target="_blank" rel="noopener noreferrer" style="display:inline-block; margin-top:6px; color:#25D366; font-weight:700; text-decoration:none; font-size:.9rem;">
                  👉 Chamar no WhatsApp Oficial (+55 11 97615-5381)
                </a>
              </div>
            </form>
          </div>

        </div>
      </div>
    </section>

  
  </main>
</Layout>
