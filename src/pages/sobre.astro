---
import Layout from '../layouts/Layout.astro';

const title = 'Sobre o Perito Grafotécnico Renato Galotti | Formação, Experiência e Credenciais';
const description = 'Conheça Renato Galotti, perito grafotécnico com 100% de aprovação em laudos. Formação, credenciais, tribunais cadastrados e metodologia científica reconhecida em todo o Brasil.';
---

<Layout
  title={title}
  description={description}
  isTransparentHeader={false}
>
  <main id="main-content">


    <!-- PAGE HERO -->
    <section class="about-hero" aria-label="Apresentação do Dr. Renato Galotti">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb" vocab="https://schema.org/" typeof="BreadcrumbList">
            <li property="itemListElement" typeof="ListItem">
              <a href="/" property="item" typeof="WebPage"><span property="name">Início</span></a>
              <meta property="position" content="1">
            </li>
            <li class="breadcrumb__sep" aria-hidden="true">›</li>
            <li property="itemListElement" typeof="ListItem">
              <span class="breadcrumb__current" property="name">Sobre</span>
              <meta property="position" content="2">
            </li>
          </ol>
        </nav>
        <div style="text-align:center; max-width:700px; margin: 0 auto; padding-top: 24px;">
          <p class="page-hero__eyebrow">Quem é Renato Galotti</p>
          <h1 class="page-hero__title" style="font-size:clamp(2rem,4vw,3rem); color:#fff; margin-bottom:16px;">Perito Grafotécnico com Histórico Único no Brasil</h1>
          <p class="page-hero__desc">Ampla trajetória profissional na ciência forense documental, com mais de 500 laudos emitidos e um histórico categórico: <strong style="color:#C9A84C">100% de vitória processual</strong> — nenhum laudo negado, nenhum processo perdido.</p>
        </div>
      </div>
    </section>

    <!-- BIO -->
    <section class="section" aria-labelledby="bio-title">
      <div class="container">
        <div class="about-bio">

          <aside class="about-photo" data-animate>
            <img
              src="/img/renato-galotti-perito-grafotecnico.jpg"
              alt="Dr. Renato Galotti — Perito Grafotécnico, especialista em perícia grafotécnica e laudos forenses"
              title="Dr. Renato Galotti | Perito Grafotécnico"
              class="about-photo__img"
              width="400"
              height="530"
              loading="lazy"
            >
            <div class="about-photo__credentials" aria-label="Credenciais e cadastros">
              <div class="credential-badge">
                <svg class="credential-badge__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
                Cadastrado TJ-SP
              </div>
              <div class="credential-badge">
                <svg class="credential-badge__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
                Cadastrado TJ-RJ
              </div>
              <div class="credential-badge">
                <svg class="credential-badge__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                Especialista em Documentoscopia Forense
              </div>
              <div class="credential-badge">
                <svg class="credential-badge__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Método Científico Certificado
              </div>
              <div class="credential-badge">
                <svg class="credential-badge__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Mais de 500 Laudos Emitidos
              </div>
            </div>
          </aside>

          <article data-animate>
            <h2 id="bio-title" style="font-size: clamp(1.5rem,2.5vw,2rem); margin-bottom:24px;">A Trajetória do Dr. Renato Galotti</h2>

            <p style="color:var(--text-muted); line-height:1.8; margin-bottom:20px;">
              Renato Galotti dedicou sua carreira ao estudo aprofundado da grafoscopia e da documentoscopia, ciências que permitem determinar, com base em evidências objetivas e reproduzíveis, a autenticidade de assinaturas, rubricas e manuscritos.
            </p>
            <p style="color:var(--text-muted); line-height:1.8; margin-bottom:20px;">
              Com sólida formação científica e especialização continuada em Perícia Grafotécnica e Documentoscopia, o Dr. Galotti construiu uma metodologia própria que combina análise morfológica clássica com recursos tecnológicos de última geração — garantindo conclusões técnicas inatacáveis.
            </p>
            <p style="color:var(--text-muted); line-height:1.8; margin-bottom:20px;">
              Ao longo de sua consolidada carreira, emitiu mais de 500 laudos grafotécnicos em processos judiciais e extrajudiciais nos principais estados do Brasil. <strong>Nenhum laudo foi negado pelo juízo. Nenhum processo foi perdido pela parte que o contratou.</strong> Um histórico de 100% de vitória processual que fala por si.
            </p>
            <p style="color:var(--text-muted); line-height:1.8; margin-bottom:36px;">
              O Dr. Galotti é cadastrado como perito nos Tribunais de Justiça e atua frequentemente em todo o território nacional, tendo atuado em casos de herança disputada, fraudes empresariais, crimes documentais, dissolução societária, falsificação de contratos bancários e muito mais. Seu compromisso é sempre com a verdade técnica e a prova material inequívoca.
            </p>

            <!-- Timeline de formação -->
            <h3 style="font-size:1.125rem; margin-bottom:20px; color:var(--navy);">Formação e Especializações</h3>
            <div style="display:flex; flex-direction:column; gap:16px; margin-bottom:36px;" role="list" aria-label="Formação acadêmica">
              <div style="display:flex; gap:16px; align-items:flex-start;" role="listitem">
                <div style="width:10px; height:10px; border-radius:50%; background:var(--gold); margin-top:6px; flex-shrink:0;"></div>
                <div>
                  <div style="font-weight:700; color:var(--navy);">Especialização em Perícia Grafotécnica & Grafoscopia</div>
                  <div style="color:var(--text-muted); font-size:.9rem;">Análise Pericial e Metodologia Científica Forense</div>
                </div>
              </div>
              <div style="display:flex; gap:16px; align-items:flex-start;" role="listitem">
                <div style="width:10px; height:10px; border-radius:50%; background:var(--gold); margin-top:6px; flex-shrink:0;"></div>
                <div>
                  <div style="font-weight:700; color:var(--navy);">Documentoscopia Avançada e Detecção de Fraudes</div>
                  <div style="color:var(--text-muted); font-size:.9rem;">Exames Físicos, Digitais e Morfológicos de Documentos</div>
                </div>
              </div>
              <div style="display:flex; gap:16px; align-items:flex-start;" role="listitem">
                <div style="width:10px; height:10px; border-radius:50%; background:var(--gold); margin-top:6px; flex-shrink:0;"></div>
                <div>
                  <div style="font-weight:700; color:var(--navy);">Assistência Técnica Judicial e Elaboração de Quesitos</div>
                  <div style="color:var(--text-muted); font-size:.9rem;">Prática Processual Civil e Penal Aplicada à Perícia</div>
                </div>
              </div>
            </div>

            <!-- Tribunais cadastrados -->
            <h3 style="font-size:1.125rem; margin-bottom:20px; color:var(--navy);">Cadastros e Abrangência</h3>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; margin-bottom:36px;" role="list" aria-label="Tribunais onde está cadastrado">
              <div style="background:var(--gray-100); border-radius:var(--radius-md); padding:16px; text-align:center; font-weight:700; color:var(--navy); font-size:.9rem;" role="listitem">TJ-SP</div>
              <div style="background:var(--gray-100); border-radius:var(--radius-md); padding:16px; text-align:center; font-weight:700; color:var(--navy); font-size:.9rem;" role="listitem">TJ-RJ</div>
              <div style="background:var(--gray-100); border-radius:var(--radius-md); padding:16px; text-align:center; font-weight:700; color:var(--navy); font-size:.9rem;" role="listitem">TRF / Justiça Federal</div>
              <div style="background:var(--gray-100); border-radius:var(--radius-md); padding:16px; text-align:center; font-weight:700; color:var(--navy); font-size:.9rem;" role="listitem">Atuação Nacional (27 Estados)</div>
            </div>

            <div style="display:flex; gap:16px; flex-wrap:wrap;">
              <a href="/contato/" class="btn btn--primary" id="about-contact-btn">Solicitar Perícia</a>
              <a href="/casos/" class="btn btn--outline" id="about-cases-btn">Ver Casos de Sucesso</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- METODOLOGIA -->
    <section class="section section--gray" aria-labelledby="method-title">
      <div class="container">
        <div class="section-header" data-animate>
          <span class="section-header__eyebrow">Como trabalho</span>
          <h2 class="section-header__title" id="method-title">Metodologia Científica Grafotécnica</h2>
          <p class="section-header__desc">Cada laudo segue um protocolo rigoroso que garante precisão, imparcialidade e validade jurídica.</p>
        </div>
        <div class="services-grid">
          <div class="service-card" data-animate data-animate-delay="1">
            <div class="service-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <h3 class="service-card__title">Análise Morfológica</h3>
            <p class="service-card__desc">Estudo detalhado da forma, proporção e estrutura de letras, números, assinaturas e rubricas. Identificação de elementos grafomotores individuais únicos do escritor.</p>
          </div>
          <div class="service-card" data-animate data-animate-delay="2">
            <div class="service-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 class="service-card__title">Exame de Traçado e Pressão</h3>
            <p class="service-card__desc">Análise da pressão exercida sobre o papel, velocidade de escrita, tremores, pausas e retoques — elementos impossíveis de falsificar com precisão.</p>
          </div>
          <div class="service-card" data-animate data-animate-delay="3">
            <div class="service-card__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <h3 class="service-card__title">Tecnologia Óptica e Digital</h3>
            <p class="service-card__desc">Utilização de microscopia, luz transmitida, luz rasante e análise digital de imagem para exame de documentos questionados com máxima precisão.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section" aria-labelledby="cta-sobre-title">
      <div class="cta-section__glow" aria-hidden="true"></div>
      <div class="container">
        <div class="cta-section__inner" data-animate>
          <h2 class="cta-section__title" id="cta-sobre-title">Converse com o Dr. Renato Galotti</h2>
          <p class="cta-section__desc">Tire suas dúvidas, solicite uma avaliação preliminar ou agende uma consulta. Atendimento rápido e personalizado.</p>
          <div class="cta-section__actions">
            <a href="https://wa.me/5511976155381?text=Ol%C3%A1%2C%20Dr.%20Renato%20Galotti!%20Vim%20pela%20p%C3%A1gina%20Sobre%20e%20gostaria%20de%20solicitar%20uma%20avalia%C3%A7%C3%A3o%20grafot%C3%A9cnica." class="btn btn--whatsapp btn--lg" target="_blank" rel="noopener noreferrer" id="cta-sobre-wa">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Falar pelo WhatsApp
            </a>
            <a href="/contato/" class="btn btn--outline btn--lg" id="cta-sobre-contact">Ver Formulário</a>
          </div>
        </div>
      </div>
    </section>

  
  </main>
</Layout>
