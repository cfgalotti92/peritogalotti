---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = await getCollection('blog');
posts.sort((a, b) => {
  const dateA = new Date(a.data.datePublished || '2026-01-01').getTime();
  const dateB = new Date(b.data.datePublished || '2026-01-01').getTime();
  return dateB - dateA;
});

const breadcrumbs = [
  { name: 'Início', url: 'https://peritogalotti.com.br/' },
  { name: 'Blog', url: 'https://peritogalotti.com.br/blog/' }
];
---

<Layout
  title="Blog de Perícia Grafotécnica | Renato Galotti"
  description="Artigos, dicas e análises técnicas sobre perícia grafotécnica, análise científica de assinaturas e grafoscopia forense. Conteúdo pelo Dr. Renato Galotti."
  canonicalUrl="https://peritogalotti.com.br/blog/"
  breadcrumbs={breadcrumbs}
>
  <main id="main-content">
    <section class="page-hero" aria-label="Blog de Perícia">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="/">Início</a></li>
            <li class="breadcrumb__sep" aria-hidden="true">›</li>
            <li class="breadcrumb__current">Blog</li>
          </ol>
        </nav>
        <div style="text-align:center; max-width:700px; margin: 0 auto; padding-top: 24px;">
          <p class="page-hero__eyebrow">Artigos e Análises</p>
          <h1 class="page-hero__title">Blog do Perito Grafotécnico</h1>
          <p class="page-hero__desc">Informações essenciais para advogados, juízes e cidadãos sobre a ciência forense documental, assinaturas falsas e o universo da perícia no Brasil.</p>
        </div>
      </div>
    </section>

    <section class="section" aria-label="Artigos Recentes">
      <div class="container">
        <div class="blog-grid" role="list">
          {posts.map((post) => {
            const slug = post.id.replace(/\.md$/, '');
            return (
              <article class="blog-card" role="listitem">
                <div class="blog-card__thumb" style="background:var(--navy-mid); display:flex; align-items:center; justify-content:center;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <path d="M16 13H8"/>
                    <path d="M16 17H8"/>
                    <path d="M10 9H8"/>
                  </svg>
                </div>
                <div class="blog-card__body">
                  <div class="blog-card__tag">{post.data.tag || 'Perícia Grafotécnica'}</div>
                  <h2 class="blog-card__title">
                    <a href={`/blog/${slug}/`}>{post.data.h1 || post.data.title}</a>
                  </h2>
                  <p class="blog-card__excerpt">{post.data.description}</p>
                  <div class="blog-card__meta">
                    {post.data.author || 'Dr. Renato Galotti'} • {post.data.readingTime || '6 min de leitura'}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</Layout>
