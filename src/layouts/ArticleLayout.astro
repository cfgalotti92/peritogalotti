---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import '../styles/style.css';

interface Props {
  post: {
    data: {
      title: string;
      description: string;
      canonicalUrl?: string;
      breadcrumbLabel?: string;
      tag?: string;
      h1: string;
      author?: string;
      datePublished?: string;
      dateModified?: string;
      dateFormatted?: string;
      readingTime?: string;
      heroImgSrc?: string;
      heroImgAlt?: string;
      ctaTitle?: string;
      ctaDesc?: string;
      ctaWhatsappUrl?: string;
    };
    id: string;
  };
}

const { post } = Astro.props;
const data = post.data;

const slug = post.id.replace(/\.md$/, '');
const canonicalUrl = data.canonicalUrl || `https://peritogalotti.com.br/blog/${slug}/`;
const ogImage = data.heroImgSrc || "https://peritogalotti.com.br/img/renato-galotti-perito-grafotecnico.jpg";
const breadcrumbName = data.breadcrumbLabel || data.h1;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": data.h1,
      "description": data.description,
      "inLanguage": "pt-BR",
      "url": canonicalUrl,
      "datePublished": data.datePublished || "2026-09-20T09:00:00-03:00",
      "dateModified": data.dateModified || data.datePublished || "2026-09-20T09:00:00-03:00",
      "image": ogImage,
      "author": {
        "@type": "Person",
        "name": data.author || "Dr. Renato Galotti",
        "jobTitle": "Perito Grafotécnico",
        "url": "https://peritogalotti.com.br/sobre/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Renato Galotti — Perito Grafotécnico",
        "url": "https://peritogalotti.com.br",
        "logo": {
          "@type": "ImageObject",
          "url": "https://peritogalotti.com.br/img/renato-galotti-perito-grafotecnico.jpg"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://peritogalotti.com.br/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://peritogalotti.com.br/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": breadcrumbName,
          "item": canonicalUrl
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{data.title}</title>
  <meta name="description" content={data.description}>
  <link rel="canonical" href={canonicalUrl}>
  <meta name="robots" content="index, follow, max-image-preview:large">

  <!-- Open Graph -->
  <meta property="og:type" content="article">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={data.title}>
  <meta property="og:description" content={data.description}>
  <meta property="og:image" content={ogImage}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230A1628'/><path d='m22 21 2.5-6.5 2.5 6.5c-.7.5-1.5.8-2.5.8s-1.8-.3-2.5-.8Zm-17 0 2.5-6.5 2.5 6.5c-.7.5-1.5.8-2.5.8s-1.8-.3-2.5-.8ZM10 27h12M16 5v22M6 10h2c2 0 5-1 8-3 3 2 6 3 8 3h2' fill='none' stroke='%23C9A84C' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
</head>
<body>
  <Header />

  <main id="main-content">
    <!-- Breadcrumbs -->
    <div style="background:var(--navy); padding: 120px 0 24px;">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="/">Início</a></li>
            <li class="breadcrumb__sep" aria-hidden="true">›</li>
            <li><a href="/blog/">Blog</a></li>
            <li class="breadcrumb__sep" aria-hidden="true">›</li>
            <li class="breadcrumb__current">{breadcrumbName}</li>
          </ol>
        </nav>
      </div>
    </div>

    <!-- Article Wrap -->
    <article class="article-wrap">
      <header class="article-header">
        <div class="article-header__meta">
          <span class="article-header__tag">{data.tag || 'Perícia Grafotécnica'}</span>
          {data.dateFormatted && <span>{data.dateFormatted}</span>}
          <span>• {data.readingTime || '6 min de leitura'}</span>
        </div>
        <h1 class="article-header__title">{data.h1}</h1>
      </header>

      <div class="article-content">
        <slot />
      </div>

      <!-- CTA Box -->
      <div style="margin-top: 48px; background: #0A1628; border-radius: 12px; padding: 36px; color: #fff; text-align: center; border: 1px solid rgba(201, 168, 76, 0.3);">
        <h3 style="font-family: 'Playfair Display', serif; font-size: 1.6rem; margin-bottom: 12px; color: #F5ECD7;">
          {data.ctaTitle || 'Precisa de um Laudo Grafotécnico com 100% de Aprovação?'}
        </h3>
        <p style="color: #9BA3AF; max-width: 540px; margin: 0 auto 24px; line-height: 1.6;">
          {data.ctaDesc || 'Entre em contato diretamente com o Dr. Renato Galotti para triagem preliminar dos documentos com sigilo e rigor técnico.'}
        </p>
        <a href={data.ctaWhatsappUrl || 'https://wa.me/5511976155381?text=Olá%2C+Dr.+Renato+Galotti!+Gostaria+de+solicitar+uma+avaliação+grafotécnica.'}
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn--primary"
           style="display: inline-flex; align-items: center; gap: 8px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Solicitar Análise de Documento
        </a>
      </div>
    </article>
  </main>

  <Footer />
  <WhatsAppFloat />
  <script is:inline src="/js/main.js"></script>
</body>
</html>
