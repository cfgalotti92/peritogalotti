---
interface Props {
  currentPath?: string;
  isTransparent?: boolean;
}

const { currentPath = Astro.url.pathname, isTransparent = false } = Astro.props;

const navItems = [
  { label: 'Início', href: '/' },
  { label: 'Serviços', href: '/servicos/' },
  { label: 'Casos', href: '/casos/' },
  { label: 'Sobre', href: '/sobre/' },
  { label: 'FAQ', href: '/faq/' },
  { label: 'Blog', href: '/blog/' }
];
---

<nav id="navbar" class={`navbar ${isTransparent ? 'navbar--transparent' : ''}`} role="navigation" aria-label="Navegação principal">
  <div class="navbar__inner">
    <a href="/" class="navbar__logo" aria-label="Renato Galotti — Perito Grafotécnico">
      <div class="navbar__logo-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
          <path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/>
          <path d="M7 21h10"/>
          <path d="M12 3v18"/>
          <path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
        </svg>
      </div>
      <div class="navbar__logo-text">
        <span class="navbar__logo-name">Renato Galotti</span>
        <span class="navbar__logo-title">Perito Grafotécnico</span>
      </div>
    </a>

    <button id="nav-toggle" class="navbar__toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-menu">
      <span></span><span></span><span></span>
    </button>

    <ul id="nav-menu" class="navbar__menu" role="menubar">
      {navItems.map((item) => {
        const isActive = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
        return (
          <li role="none">
            <a href={item.href} class={`navbar__link ${isActive ? 'navbar__link--active' : ''}`} role="menuitem">
              {item.label}
            </a>
          </li>
        );
      })}
      <li role="none" class="navbar__cta">
        <a href="https://wa.me/5511976155381?text=Olá%2C+Dr.+Renato+Galotti!+Vim+pelo+site+e+gostaria+de+solicitar+uma+perícia+grafotécnica."
           class="btn btn--primary btn--sm"
           id="nav-whatsapp-cta"
           target="_blank"
           rel="noopener noreferrer"
           aria-label="Falar com o Dr. Renato Galotti pelo WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          WhatsApp
        </a>
      </li>
    </ul>
  </div>
</nav>
